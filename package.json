{
  "name": "gameweave-games",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "validate": "gameweave validate --all",
    "test": "gameweave test --all",
    "check": "gameweave check --all",
    "boardlang:fmt": "gameweave fmt games modules",
    "boardlang:fmt:check": "gameweave fmt --check games modules",
    "boardlang:lint": "gameweave lint --max-warnings 0 games modules",
    "boardlang:lint:fix": "gameweave lint --fix games modules",
    "format": "prettier --write \"**/*.{md,json,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{md,json,yml,yaml}\""
  },
  "devDependencies": {
    "gameweave": "0.7.0",
    "prettier": "3.9.10",
    "sharp": "0.35.5"
  }
}
